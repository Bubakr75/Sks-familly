rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Modèle d'autorisation :
    // - l'identité et le rôle viennent exclusivement de members/{uid} ;
    // - familyId est porté par le chemin, sans migration des documents métier ;
    // - les opérations d'administration restent réservées aux Cloud Functions.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveMember(familyId) {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        );
    }

    function member(familyId) {
      return get(
        /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
      ).data;
    }

    function activeFamilyMember(familyId) {
      return hasActiveMember(familyId) &&
        member(familyId).active == true &&
        member(familyId).uid == request.auth.uid &&
        (
          member(familyId).role == 'parent' ||
          member(familyId).role == 'manager' ||
          member(familyId).role == 'familyAdmin' ||
          (
            member(familyId).role == 'child' &&
            member(familyId).childId is string &&
            member(familyId).childId.size() > 0
          ) ||
          (
            member(familyId).role == 'owner' &&
            get(
              /databases/$(database)/documents/families/$(familyId)
            ).data.ownerUid == request.auth.uid
          )
        );
    }

    function isFamilyOwner(familyId) {
      return activeFamilyMember(familyId) &&
        member(familyId).role == 'owner' &&
        get(
          /databases/$(database)/documents/families/$(familyId)
        ).data.ownerUid == request.auth.uid;
    }

    function isFamilyParent(familyId) {
      return activeFamilyMember(familyId) &&
        (
          member(familyId).role == 'parent' ||
          member(familyId).role == 'manager' ||
          member(familyId).role == 'familyAdmin' ||
          isFamilyOwner(familyId)
        );
    }

    function isFamilyManager(familyId) {
      return activeFamilyMember(familyId) &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        (
          member(familyId).role == 'manager' ||
          member(familyId).role == 'familyAdmin'
        );
    }

    function isFamilyChild(familyId) {
      return activeFamilyMember(familyId) &&
        member(familyId).role == 'child' &&
        member(familyId).childId is string &&
        member(familyId).childId.size() > 0;
    }

    // Fenêtre transitoire pour l'APK +505. Elle conserve uniquement les
    // écritures historiques indispensables, dans la famille authentifiée.
    // À partir du 1er octobre 2026, seules les Functions serveur restent
    // autorisées pour les soldes et l'historique.
    function legacyCompatibilityWindow() {
      return request.time < timestamp.date(2026, 10, 1);
    }

    function canReadChildWallet(familyId, childId) {
      return isFamilyParent(familyId) ||
        (
          isFamilyChild(familyId) &&
          member(familyId).childId == childId
        );
    }

    // Les modèles historiques sont souples. Cette borne empêche l'ajout d'un
    // nombre déraisonnable de champs sans exiger de modifier les documents.
    function isBoundedBusinessDocument(data) {
      return data.keys().size() <= 80;
    }

    function isLegacyPointUpdate(data) {
      return legacyCompatibilityWindow() &&
        data.keys().size() <= 24 &&
        data.points is int &&
        data.points >= 0 &&
        data.points <= 10000000 &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'points',
          'lastModifiedBy'
        ]) &&
        (
          !('lastModifiedBy' in data) ||
          (
            data.lastModifiedBy is string &&
            data.lastModifiedBy.size() <= 128
          )
        );
    }

    function isValidLegacyHistory(data, entryId) {
      return legacyCompatibilityWindow() &&
        data.keys().hasOnly([
          'id',
          'childId',
          'points',
          'reason',
          'category',
          'date',
          'isBonus',
          'proofPhotoBase64',
          'actionBy',
          'transferId',
          'counterpartyChildId',
          'deviceId'
        ]) &&
        data.keys().hasAll([
          'id',
          'childId',
          'points',
          'reason',
          'category',
          'date',
          'isBonus',
          'proofPhotoBase64',
          'actionBy',
          'deviceId'
        ]) &&
        data.id is string &&
        data.id == entryId &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.childId is string &&
        data.childId.size() > 0 &&
        data.childId.size() <= 128 &&
        data.points is int &&
        data.points >= 0 &&
        data.points <= 100000 &&
        data.reason is string &&
        data.reason.size() > 0 &&
        data.reason.size() <= 500 &&
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 80 &&
        data.date is string &&
        data.date.size() >= 10 &&
        data.date.size() <= 40 &&
        data.isBonus is bool &&
        data.proofPhotoBase64 == null &&
        (
          data.actionBy == null ||
          (
            data.actionBy is string &&
            data.actionBy.size() <= 80
          )
        ) &&
        data.deviceId is string &&
        data.deviceId.size() > 0 &&
        data.deviceId.size() <= 128 &&
        (
          !('transferId' in data) ||
          (
            data.transferId is string &&
            data.transferId.size() > 0 &&
            data.transferId.size() <= 128
          )
        ) &&
        (
          !('counterpartyChildId' in data) ||
          (
            data.counterpartyChildId is string &&
            data.counterpartyChildId.size() > 0 &&
            data.counterpartyChildId.size() <= 128
          )
        );
    }

    function isValidChildRequest(data, requestId) {
      return data.keys().hasOnly([
          'id',
          'type',
          'childId',
          'requestedBy',
          'text',
          'amount',
          'status',
          'createdAt',
          'extra',
          'lastModifiedBy',
          'readBy'
        ]) &&
        data.keys().hasAll([
          'id',
          'type',
          'childId',
          'requestedBy',
          'text',
          'amount',
          'status',
          'createdAt',
          'extra'
        ]) &&
        data.id is string &&
        data.id == requestId &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.type is string &&
        data.type.size() > 0 &&
        data.type.size() <= 40 &&
        data.childId is string &&
        data.childId.size() > 0 &&
        data.childId.size() <= 128 &&
        data.requestedBy is string &&
        data.requestedBy.size() > 0 &&
        data.requestedBy.size() <= 120 &&
        data.text is string &&
        data.text.size() <= 2000 &&
        data.amount is int &&
        data.amount >= 0 &&
        data.amount <= 100000 &&
        data.status == 'pending' &&
        data.createdAt is string &&
        data.createdAt.size() >= 10 &&
        data.createdAt.size() <= 40 &&
        data.extra is map &&
        data.extra.size() <= 20 &&
        (
          !('readBy' in data) ||
          (
            data.readBy is list &&
            data.readBy.size() == 0
          )
        ) &&
        (
          !('lastModifiedBy' in data) ||
          (
            data.lastModifiedBy is string &&
            data.lastModifiedBy.size() <= 128
          )
        );
    }

    function isValidFcmToken(data, deviceId) {
      return data.keys().hasOnly([
          'token',
          'deviceId',
          'uid',
          'platform',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'token',
          'deviceId',
          'uid',
          'platform',
          'updatedAt'
        ]) &&
        data.token is string &&
        data.token.size() > 0 &&
        data.token.size() <= 4096 &&
        data.deviceId is string &&
        data.deviceId == deviceId &&
        data.deviceId.size() > 0 &&
        data.deviceId.size() <= 128 &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.platform is string &&
        data.platform.size() > 0 &&
        data.platform.size() <= 32 &&
        data.updatedAt is timestamp;
    }

    match /families/{familyId} {
      // Création et administration via les callables de family_management.js.
      allow read: if activeFamilyMember(familyId);
      allow create, update, delete: if false;

      match /children/{childId} {
        allow read: if activeFamilyMember(familyId);
        allow create: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data) &&
          request.resource.data.points == 0;
        // Les soldes sont modifiés exclusivement par les Cloud Functions.
        allow update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data) &&
          (
            request.resource.data.points == resource.data.points ||
            isLegacyPointUpdate(request.resource.data)
          );
        allow delete: if isFamilyParent(familyId);
      }

      match /history/{entryId} {
        allow read: if activeFamilyMember(familyId);
        // L'auteur et l'horodatage sont attribués par Firebase Admin.
        // Compatibilité +505 : création legacy strictement bornée, sans photo
        // base64 et sans champs d'identité serveur.
        allow create: if isFamilyParent(familyId) &&
          isValidLegacyHistory(request.resource.data, entryId);
        allow update, delete: if false;
      }

      match /goals/{goalId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /punishments/{punishmentId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /notes/{noteId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /immunities/{immunityId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      // Les transitions enfant doivent migrer vers une callable transactionnelle.
      match /trades/{tradeId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      // Les votes enfant sont bloqués tant qu'ils réécrivent le document entier.
      match /tribunal/{caseId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /custom_badges/{badgeId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /screen_time/{key} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      // Le document contient à la fois le solde et la session : écriture parent
      // seulement jusqu'à séparation du modèle ou ajout d'une callable.
      match /screen_time_accounts/{childId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /fcm_tokens/{deviceId} {
        allow read: if false;
        allow create: if activeFamilyMember(familyId) &&
          isValidFcmToken(request.resource.data, deviceId);
        allow update: if activeFamilyMember(familyId) &&
          resource.data.uid == request.auth.uid &&
          resource.data.deviceId == deviceId &&
          isValidFcmToken(request.resource.data, deviceId);
        allow delete: if activeFamilyMember(familyId) &&
          resource.data.uid == request.auth.uid &&
          resource.data.deviceId == deviceId;
      }

      // Ces profils contiennent les données de récupération du PIN.
      match /parent_profiles/{profileId} {
        allow read: if isFamilyParent(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /requests/{requestId} {
        allow get: if isFamilyParent(familyId) ||
          (
            isFamilyChild(familyId) &&
            resource.data.childId == member(familyId).childId
          );
        allow list: if isFamilyParent(familyId) ||
          (
            legacyCompatibilityWindow() &&
            activeFamilyMember(familyId)
          ) ||
          (
            isFamilyChild(familyId) &&
            resource.data.childId == member(familyId).childId
          );
        allow create: if isValidChildRequest(
            request.resource.data,
            requestId
          ) &&
          (
            isFamilyParent(familyId) ||
            (
              isFamilyChild(familyId) &&
              member(familyId).childId == request.resource.data.childId
            )
          );
        allow update: if isFamilyParent(familyId) &&
          isValidChildRequest(request.resource.data, requestId);
        allow delete: if isFamilyParent(familyId);
      }

      match /chores/{choreId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      // Un achat enfant direct permettrait de forger prix, points et stock.
      match /purchases/{purchaseId} {
        allow read: if activeFamilyMember(familyId);
        allow create, update: if isFamilyParent(familyId) &&
          isBoundedBusinessDocument(request.resource.data);
        allow delete: if isFamilyParent(familyId);
      }

      match /wallets/{childId} {
        allow read: if canReadChildWallet(familyId, childId);
        allow write: if false;

        match /operations/{operationId} {
          allow read: if canReadChildWallet(familyId, childId);
          allow write: if false;
        }
      }

      // Écriture exclusivement via les Cloud Functions de rattachement.
      match /join_requests/{requestId} {
        allow read: if isFamilyOwner(familyId) ||
          isFamilyManager(familyId) ||
          (
            isSignedIn() &&
            requestId == request.auth.uid &&
            resource.data.requesterUid == request.auth.uid
          );
        allow write: if false;
      }

      // L'autorité de rôle est écrite exclusivement par Firebase Admin.
      match /members/{memberId} {
        allow get: if isFamilyOwner(familyId) ||
          (
            isSignedIn() &&
            memberId == request.auth.uid &&
            resource.data.uid == request.auth.uid
          );
        allow list: if isFamilyOwner(familyId);
        allow write: if false;
      }
    }

    // family_codes, join_rate_limits, legacy_family_migration_claims,
    // _diagnostic_test et tout chemin non déclaré restent réservés au serveur.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
